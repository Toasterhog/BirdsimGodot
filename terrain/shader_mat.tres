[sub_resource type="Shader" id="Shader_gbfbk"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform sampler2D tex1 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex2 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex3 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D maskNoise : source_color, filter_linear_mipmap, repeat_disable;
uniform sampler2D maskHeight : source_color, filter_linear_mipmap, repeat_disable;

uniform float texture_scale1 = 75.0;
uniform float texture_scale2 = 75.0;

//uniform vec4 albedo : source_color = vec4(1.0);
//uniform float roughness : hint_range(0.0, 1.0) = 1.0;
//uniform float metallic : hint_range(0.0, 1.0) = 0.0;
uniform float heightmapContribution : hint_range(0.0, 1.0) = 0.5;
uniform sampler2D gradientTexture;


void fragment() {
	// Original UV: 0 -> 1 across the entire terrain
	vec2 mask_uv = UV;

	// Repeat the textures across the terrain
	float mask_value = (texture(maskNoise, mask_uv).r *(1.0-heightmapContribution) + texture(maskHeight, mask_uv).r * heightmapContribution);
	vec3 weights = texture(gradientTexture, vec2(mask_value,0)).rgb;

	vec3 color1 = texture(tex1, UV * texture_scale1).rgb;
	vec3 color2 = texture(tex2, UV * texture_scale2).rgb;
	vec3 color3 = texture(tex3, UV * texture_scale1).rgb;
	
	//float mix_val = clamp(mask_value*2.0f-0.5f, 0.0, 1.0);
	//ALBEDO = mix(color1, color2, mix_val) ;
	ALBEDO = color1 * weights.r + color2 * weights.g + color3 * weights.b;
	
	ROUGHNESS = 1.0 - weights.b * 0.2; //roughness;
	METALLIC = 0.0; //metallic;
	SPECULAR = 0.0;
}"

